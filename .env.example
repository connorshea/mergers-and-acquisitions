# Copy to .env for local dev (loaded by dotenv). In production these come from
# the Toolforge tool's ToolsDB credentials, set as job/webservice env vars.

# --- database (local Homebrew MariaDB defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mergers
DB_PASSWORD=mergers
DB_NAME=mergers
# DB_POOL=5              # web-server connection pool size

# --- web server ---
PORT=8000
# CLIENT_DIR=./dist/client   # where the built SPA lives (prod)

# --- authentication (Wikimedia OAuth 2.0) ---
# Leave these unset to run the app read-only (login returns 503). See
# README.md "Authentication" for registering the consumer on meta.wikimedia.org.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# Must be Wikidata, with the `www.` (the bare host redirects, which turns the
# token POST into a GET and fails with 405).
# OAUTH_ISSUER=https://www.wikidata.org/w/rest.php/oauth2
# Public origin of the app; also the base of the OAuth callback URL
# (<BASE_URL>/api/auth/callback). Cookies are Secure iff this is https.
# Dev default below; on Toolforge this is https://mna.toolforge.org
# BASE_URL=http://localhost:5173
# HMAC key for the login-state cookie, >= 32 chars:  openssl rand -base64 48
# SESSION_SECRET=
# AES-256 key for OAuth tokens at rest, 32 bytes base64:  openssl rand -base64 32
# TOKEN_ENC_KEY=
# TOKEN_ENC_KEY_PREVIOUS=    # the old key during a rotation (decrypt-only)
# Comma-separated Wikimedia central user ids allowed to run hunt/reset/sync.
# (Your id is `sub` at https://www.wikidata.org/w/rest.php/oauth2/resource/profile,
# or `userid` from https://www.wikidata.org/w/api.php?action=query&meta=userinfo.)
# ADMIN_USERS=
# Where edits (merges, "different from" claims) go; point at
# https://test.wikidata.org/w/api.php while developing. Revision links in the
# UI follow it. Note the mirror is of real Wikidata, so QIDs won't line up on
# Test Wikidata: merge testing there is against ad-hoc test items.
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Max Wikidata edits per user per minute through the app (merge + claims).
# EDIT_RATE_LIMIT=10
# USER_AGENT=mergers-and-acquisitions/0.1 (https://...; mailto:you@example.org)

# --- Wikidata sync ---
# WIKIDATA_SPARQL_ENDPOINT=https://qlever.dev/api/wikidata   # QLever by default
# WIKIDATA_DUMP_PATH=seed-data/wikidata_games.json   # legacy vglist blob for `pnpm seed`
# SEED_LIMIT=2000        # seed only the first N games (local iteration)
# The entity JSON dump `pnpm job:import-dump` streams (server/dump-import.ts).
# Default is Toolforge's NFS copy; a plain .json (not .bz2) works too.
# WIKIDATA_JSON_DUMP=/public/dumps/public/wikidatawiki/entities/latest-all.json.gz
# DUMP_LIMIT=2000        # stop after N matching games (timing check; disables pruning)
# DUMP_PRUNE=0           # keep items the dump no longer contains
# DUMP_PRUNE_FORCE=1     # prune even if >20% of the mirror would go

# --- Wiki Replicas (jobs/resolve-sitelinks.ts, jobs/resolve-creations.ts) ---
# Set on Toolforge automatically. From a dev machine, tunnel through the
# bastion; `{wiki}` in these is replaced with the site id (e.g. enwiki).
# TOOL_REPLICA_USER=
# TOOL_REPLICA_PASSWORD=
# REPLICA_HOST={wiki}.analytics.db.svc.wikimedia.cloud
# REPLICA_PORT=3306
# REPLICA_DB={wiki}_p
