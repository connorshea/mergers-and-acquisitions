# Copy to .env for local dev (loaded by dotenv). In production these come from
# the Toolforge tool's ToolsDB credentials, set as job/webservice env vars.

# --- database (local Homebrew MariaDB defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mergers
DB_PASSWORD=mergers
DB_NAME=mergers
# DB_POOL=5              # web-server connection pool size

# --- web server ---
PORT=8000
# CLIENT_DIR=./dist/client   # where the built SPA lives (prod)

# --- authentication (Wikimedia OAuth 2.0) ---
# Leave these unset to run the app read-only (login returns 503). See
# README.md "Authentication" for registering the consumer on meta.wikimedia.org.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ISSUER=https://meta.wikimedia.org/w/rest.php/oauth2
# Public origin of the app; also the base of the OAuth callback URL
# (<BASE_URL>/api/auth/callback). Cookies are Secure iff this is https.
# BASE_URL=http://localhost:5173
# HMAC key for the login-state cookie, >= 32 chars:  openssl rand -base64 48
# SESSION_SECRET=
# AES-256 key for OAuth tokens at rest, 32 bytes base64:  openssl rand -base64 32
# TOKEN_ENC_KEY=
# TOKEN_ENC_KEY_PREVIOUS=    # the old key during a rotation (decrypt-only)
# Comma-separated Wikimedia central user ids allowed to run hunt/reset/sync.
# (Your id is `sub` at https://meta.wikimedia.org/w/rest.php/oauth2/resource/profile,
# or `userid` from https://www.wikidata.org/w/api.php?action=query&meta=userinfo.)
# ADMIN_USERS=
# Where edits go; point at https://test.wikidata.org/w/api.php while developing.
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# USER_AGENT=mergers-and-acquisitions/0.1 (https://...; mailto:you@example.org)

# --- Wikidata sync ---
# WIKIDATA_SPARQL_ENDPOINT=https://qlever.dev/api/wikidata   # QLever by default
# WIKIDATA_DUMP_PATH=seed-data/wikidata_games.json
# SEED_LIMIT=2000        # seed only the first N games (local iteration)
