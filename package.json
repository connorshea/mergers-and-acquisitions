{
  "name": "wikidata-merge-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.ts\" \"vp dev\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vp dev",
    "build": "vp build",
    "start": "node server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "import-items": "node scripts/import-items.ts",
    "job:hunt": "node jobs/hunt.ts",
    "job:import-dump": "node jobs/import-dump.ts",
    "job:sync-properties": "node jobs/sync-properties.ts",
    "job:sync-entity-labels": "node jobs/sync-entity-labels.ts",
    "job:sync-place-ancestors": "node jobs/sync-place-ancestors.ts",
    "job:prune-sessions": "node jobs/prune-sessions.ts",
    "job:resolve-sitelinks": "node jobs/resolve-sitelinks.ts",
    "job:resolve-creations": "node jobs/resolve-creations.ts",
    "job:resolve-merges": "node jobs/resolve-merges.ts",
    "eval:fetch-pairs": "node scripts/fetch-merge-pairs.ts",
    "eval:fetch-nondupes": "node scripts/fetch-nondupe-pairs.ts",
    "eval:score": "node scripts/eval-score.ts",
    "eval:llm": "node scripts/eval-llm.ts",
    "eval:resolve-redirects": "node scripts/resolve-eval-redirects.ts",
    "eval:resolve-subject-types": "node scripts/resolve-eval-subject-types.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.41.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.27.0"
}
